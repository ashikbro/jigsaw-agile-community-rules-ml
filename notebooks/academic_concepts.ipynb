    "## 8. Academic Concept: Data Augmentation\n",
    "\n",
    "Demonstrating text data augmentation techniques."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Text augmentation functions\n",
    "def random_deletion(text, p=0.1):\n",
    "    \"\"\"Randomly delete words from the text with probability p.\"\"\"\n",
    "    words = text.split()\n",
    "    if len(words) <= 1:\n",
    "        return text\n",
    "        \n",
    "    new_words = [word for word in words if np.random.random() > p]\n",
    "    return ' '.join(new_words) if new_words else words[0]\n",
    "\n",
    "def random_swap(text, n=1):\n",
    "    \"\"\"Randomly swap n pairs of words in the text.\"\"\"\n",
    "    words = text.split()\n",
    "    if len(words) < 2:\n",
    "        return text\n",
    "        \n",
    "    for _ in range(n):\n",
    "        idx1, idx2 = np.random.choice(range(len(words)), 2, replace=False)\n",
    "        words[idx1], words[idx2] = words[idx2], words[idx1]\n",
    "        \n",
    "    return ' '.join(words)\n",
    "\n",
    "# Demonstrate augmentation\n",
    "sample_texts = df['processed_comment'].iloc[:5].tolist()\n",
    "\n",
    "for i, text in enumerate(sample_texts):\n",
    "    print(f\"Original {i+1}: {text}\")\n",
    "    print(f\"Deletion {i+1}: {random_deletion(text)}\")\n",
    "    print(f\"Swap {i+1}: {random_swap(text)}\n\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Academic Concept: Cross-Validation\n",
    "\n",
    "Demonstrating k-fold cross-validation for model evaluation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import KFold, cross_val_score\n",
    "\n",
    "# Define models to compare\n",
    "cv_models = {\n",
    "    'Logistic Regression': LogisticRegression(max_iter=1000, random_state=42),\n",
    "    'Random Forest': RandomForestClassifier(n_estimators=50, random_state=42)  # Reduced for speed\n",
    "}\n",
    "\n",
    "# Set up k-fold cross-validation\n",
    "k = 5\n",
    "kf = KFold(n_splits=k, shuffle=True, random_state=42)\n",
    "\n",
    "# Perform cross-validation\n",
    "cv_results = {}\n",
    "\n",
    "for name, model in cv_models.items():\n",
    "    # Get cross-validation scores\n",
    "    cv_scores = cross_val_score(model, X_train_tfidf, y_train, cv=kf, scoring='f1')\n",
    "    \n",
    "    # Store results\n",
    "    cv_results[name] = {\n",
    "        'scores': cv_scores,\n",
    "        'mean': cv_scores.mean(),\n",
    "        'std': cv_scores.std()\n",
    "    }\n",
    "    \n",
    "    print(f\"{name} - Mean F1: {cv_scores.mean():.3f}, Std: {cv_scores.std():.3f}\")\n",
    "\n",
    "# Visualize cross-validation results\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "for i, (name, result) in enumerate(cv_results.items()):\n",
    "    plt.errorbar(i, result['mean'], yerr=result['std'], fmt='o', capsize=10, label=name)\n",
    "    \n",
    "    # Plot individual fold scores\n",
    "    x = np.random.normal(i, 0.05, size=k)  # Add jitter for visibility\n",
    "    plt.scatter(x, result['scores'], alpha=0.6)\n",
    "\n",
    "plt.xticks(range(len(cv_results)), cv_results.keys())\n",
    "plt.ylabel('F1 Score')\n",
    "plt.title(f'{k}-Fold Cross-Validation Results')\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "\n",
    "# Add mean values as text\n",
    "for i, (name, result) in enumerate(cv_results.items()):\n",
    "    plt.text(i, result['mean'] + 0.02, f\"{result['mean']:.3f}\", ha='center')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
